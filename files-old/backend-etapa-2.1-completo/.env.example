# ============================================================================
# VARIÁVEIS DE AMBIENTE — Backend Sistema de Metas
# ============================================================================
# NUNCA commit este arquivo COM valores reais
# Copie para .env e preencha com seus valores

# ============================================================================
# SERVER
# ============================================================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
LOG_LEVEL=info

# ============================================================================
# FRONTEND
# ============================================================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# DATABASE — PostgreSQL
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metas_db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_POOL_MIN=2
DB_POOL_MAX=10

# Connection string completa (alternativa)
# DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/metas_db

# ============================================================================
# JWT — Autenticação
# ============================================================================
JWT_SECRET=sua_chave_super_secreta_minimo_32_caracteres_!!!
JWT_EXPIRY=1h
JWT_REFRESH_SECRET=outra_chave_super_secreta_minimo_32_caracteres_!!!
JWT_REFRESH_EXPIRY=7d

# ============================================================================
# MICROSOFT ENTRA ID — Autenticação
# ============================================================================
MSAL_CLIENT_ID=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
MSAL_CLIENT_SECRET=seu_client_secret_entra_id
MSAL_TENANT_ID=seu_tenant_id_azure
MSAL_AUTHORITY=https://login.microsoftonline.com/seu_tenant_id
MSAL_GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0

# Para validação de token
MSAL_SCOPES=https://graph.microsoft.com/.default

# ============================================================================
# STORAGE — AWS S3 para Attachments (ou local)
# ============================================================================
STORAGE_TYPE=local
# STORAGE_TYPE=s3

# Se local:
STORAGE_LOCAL_PATH=./uploads

# Se S3:
AWS_S3_BUCKET=seu-bucket-name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=seu_access_key_id
AWS_SECRET_ACCESS_KEY=seu_secret_access_key
AWS_S3_URL_EXPIRY=3600

# ============================================================================
# EMAIL — Notificações
# ============================================================================
SMTP_HOST=smtp.sua-empresa.com
SMTP_PORT=587
SMTP_USER=seu_email@empresa.com
SMTP_PASSWORD=sua_senha_smtp
SMTP_FROM=noreply@empresa.com
SMTP_FROM_NAME=Sistema de Metas
MAIL_ENABLED=true

# ============================================================================
# OBSERVABILIDADE — Logging
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs

# Sentry (opcional, para error tracking)
SENTRY_DSN=

# ============================================================================
# APLICAÇÃO
# ============================================================================
# Modo manutenção
MAINTENANCE_MODE=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Paginação padrão
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Tamanho máximo de arquivo upload (bytes)
MAX_FILE_SIZE=10485760

# ============================================================================
# DESENVOLVIMENTO
# ============================================================================
DEBUG=false
SEED_DB=false
