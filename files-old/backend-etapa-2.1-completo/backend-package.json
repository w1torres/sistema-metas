{
  "name": "sistema-metas-backend",
  "version": "2.0.0",
  "description": "Backend — Sistema de Acompanhamento de Metas com Fluxo de Aprovações",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && echo 'Build completo!'",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:create": "psql -U postgres -h localhost -c \"CREATE DATABASE metas_db;\" || true",
    "db:drop": "psql -U postgres -h localhost -c \"DROP DATABASE IF EXISTS metas_db;\"",
    "db:migrate": "knex migrate:latest --env development",
    "db:rollback": "knex migrate:rollback --env development",
    "db:seed": "knex seed:run --env development",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "typescript": "^6.0.2",
    "dotenv": "^16.3.1",
    "pg": "^8.11.0",
    "knex": "^3.1.0",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "@microsoft/microsoft-graph-client": "^3.0.0",
    "axios": "^1.6.0",
    "joi": "^17.11.0",
    "multer": "^1.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "xlsx": "^0.18.5",
    "papaparse": "^5.4.1",
    "aws-sdk": "^2.1561.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "metas",
    "indicadores",
    "aprovacoes",
    "ppr",
    "trilhas",
    "api",
    "rest",
    "nodejs",
    "typescript",
    "postgresql"
  ],
  "author": "Sua Empresa",
  "license": "PROPRIETARY"
}
