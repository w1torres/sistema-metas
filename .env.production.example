# Copie para .env.production na VPS e preencha. Nunca commite o .env.production.

# --- Publicação ---
WEB_ROOT=/var/www/metas-adm
# Só altere se outro nginx (ex.: o do projeto-metas) já usa 80/443 nesta VPS.
HTTP_PORT=80
HTTPS_PORT=443

# --- Backend ---
FRONTEND_URL=https://sistema-metas.appstche.com.br
CORS_ORIGIN=https://sistema-metas.appstche.com.br

DB_NAME=metas_db
DB_USER=metas_adm
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DB_POOL_MIN=2
DB_POOL_MAX=10

# Gere com: openssl rand -hex 32
JWT_SECRET=TROQUE_POR_UMA_CHAVE_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRY=8h

CORPORATE_EMAIL_DOMAINS=tcheagricola.com.br
MSAL_CLIENT_ID=
MSAL_TENANT_ID=
PASSWORD_RESET_TOKEN_TTL_HOURS=48

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tcheagricola.com.br

MAX_FILE_SIZE=10485760
IMPORT_MAX_FILE_SIZE=5242880
IMPORT_MAX_ROWS=1000
LOG_LEVEL=info

# --- Frontend (lidas só no build, feito pelo deploy-vm.sh) ---
# Vazio = mesma origem (o nginx encaminha /api para o backend).
VITE_API_URL=
VITE_CORPORATE_EMAIL_DOMAINS=tcheagricola.com.br
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_REDIRECT_URI=https://sistema-metas.appstche.com.br
VITE_MSAL_MODO_LOCAL=false
