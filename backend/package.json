{
  "name": "sistema-metas-backend",
  "version": "0.1.0",
  "description": "Backend — Sistema de Acompanhamento de Metas (indicadores, aprovações, PPR)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rollback": "tsx src/db/rollback.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "npm run db:rollback && npm run db:migrate && npm run db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "knex": "^3.1.0",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.13.3",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "winston": "^3.13.0",
    "date-fns": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["metas", "indicadores", "aprovacoes", "ppr", "trilhas", "api", "rest", "typescript", "postgresql"],
  "license": "PROPRIETARY"
}
