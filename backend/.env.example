# Copie para .env e preencha os valores. Nunca commit o .env de verdade.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database — PostgreSQL (porta 5433 no docker-compose — a máquina já tem um
# PostgreSQL nativo ocupando a 5432 por padrão)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=metas_db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=troque_esta_chave_por_uma_com_pelo_menos_32_caracteres
JWT_EXPIRY=8h

# Autenticação — domínio(s) de email corporativo entram por Microsoft Entra
# ID, qualquer outro domínio entra por senha (ver módulo auth/). Lista
# separada por vírgula, não hardcoded, pra dar pra adicionar domínio novo
# sem precisar mexer em código.
CORPORATE_EMAIL_DOMAINS=tcheagricola.com.br

# Microsoft Entra ID — mesma app registration usada pelo projeto-metas
# (ver projeto-metas/backend/.env), só o redirect URI muda por aplicação.
# O backend só valida a assinatura/emissor/audiência do token que o frontend
# já obteve via MSAL (@azure/msal-browser) contra o JWKS da Microsoft — não
# precisa do client secret (esse fica só com quem faz o fluxo confidential
# client, que não é o caso aqui).
MSAL_CLIENT_ID=
MSAL_TENANT_ID=
# Só pra rodar local sem precisar completar o login Entra de verdade — o
# backend aceita um "login Entra simulado" pra um email corporativo já
# cadastrado, SEM validar token nenhum. Nunca fica ligado se NODE_ENV=production,
# mesmo que essa variável esteja true (ver checagem em auth/service.ts).
MSAL_MODO_LOCAL=false
# Login antigo (só email) — só até o frontend terminar de migrar pro login
# real. Nunca true em produção (ver config/env.ts).
DEV_LOGIN_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_HOURS=48

# SMTP — sem host configurado, o email de "definir senha" só é logado no
# console (ver utils/email.ts), não é enviado de verdade. Preencha pra testar
# o envio real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tcheagricola.com.br

# Storage de anexos — só "local" está implementado nesta etapa
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE=10485760

# Import de planilha
IMPORT_MAX_FILE_SIZE=5242880
IMPORT_MAX_ROWS=1000

LOG_LEVEL=info
