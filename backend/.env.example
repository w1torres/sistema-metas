# Copie para .env e preencha os valores. Nunca commit o .env de verdade.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database — PostgreSQL (porta 5433 no docker-compose — a máquina já tem um
# PostgreSQL nativo ocupando a 5432 por padrão)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=metas_db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=troque_esta_chave_por_uma_com_pelo_menos_32_caracteres
JWT_EXPIRY=8h

# Storage de anexos — só "local" está implementado nesta etapa
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE=10485760

# Import de planilha
IMPORT_MAX_FILE_SIZE=5242880
IMPORT_MAX_ROWS=1000

LOG_LEVEL=info
