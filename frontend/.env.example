# Etapa 2 (Backend + Entra ID)
VITE_API_URL=http://localhost:3001

# Mesma lista do backend (CORPORATE_EMAIL_DOMAINS) — só usada aqui pra
# decidir qual formulário mostrar (senha vs. Microsoft) conforme o email
# digitado. Quem decide de verdade é sempre o backend.
VITE_CORPORATE_EMAIL_DOMAINS=tcheagricola.com.br

# Mesma app registration do Azure AD usada pelo backend (ver
# backend/.env.example) — Client ID/Tenant ID não são segredo (é um client
# público de SPA), mas cada ambiente (local/prod) registra seu próprio
# redirect URI na mesma app registration.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
# Página de retorno do popup (redirect.html) — cadastrar essa URL exata no Azure (tipo SPA).
# Local: http://localhost:5173/redirect.html — Produção: https://sistema-metas.appstche.com.br/redirect.html
VITE_MSAL_REDIRECT_URI=http://localhost:5173/redirect.html
# Espelha MSAL_MODO_LOCAL do backend — só true enquanto o redirect URI desta
# SPA ainda não foi registrado no Azure AD (ver auth/entraId.ts).
VITE_MSAL_MODO_LOCAL=false
